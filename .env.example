# Modelo de variaveis de ambiente. COPIE este arquivo para .env.local e preencha os valores reais.
# O .env.local e ignorado pelo git (.gitignore) — NUNCA commite a senha do banco.

# Connection string do Postgres do Supabase (Project Settings > Database > Connection string > URI).
# Use a porta 6543 (pooler) OU 5432 (direta). Substitua [YOUR-PASSWORD] pela senha do banco.
# Exemplo (NAO e real):
# SUPABASE_DB_URL=postgresql://postgres.bizfrksuwscosxutunfy:SUA_SENHA_AQUI@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# Service Role Key do Supabase (Project Settings > API > service_role, "secret").
# Usada SOMENTE nas Serverless Functions (ex.: /api/admin-senha) para a Admin API.
# NUNCA exponha no front-end. Defina tambem em Vercel > Project Settings > Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=
